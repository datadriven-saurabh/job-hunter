# Local-only AI. Start Ollama and pull an installed model before enabling.
ENABLE_LOCAL_LLM=false
# Preparation and drafting work without enabling live submissions.
ENABLE_LIVE_SUBMISSION=false

# Optional Chrome extension: copy its 32-letter ID from chrome://extensions.
# Empty means no extensions are trusted. Comma-separate IDs if needed.
TRUSTED_EXTENSION_IDS=

# Hosted private-beta mode (leave DATABASE_URL empty for the local edition).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
APP_URL=
ADDITIONAL_WEB_ORIGINS=
ENVIRONMENT=local

# Optional server-side AI providers. Never use these as NEXT_PUBLIC variables.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional hosted AI. Only the two reviewed :free models are accepted.
# Every request re-checks zero token pricing, and deterministic generation remains available.
ENABLE_OPENROUTER=false
OPENROUTER_FREE_MODELS=deepseek/deepseek-v4-flash-0731:free,qwen/qwen3.8-27b:free
MAX_OPENROUTER_REQUESTS_PER_DAY=40
MAX_OPENROUTER_REQUESTS_PER_USER_PER_DAY=8
OPENROUTER_CATALOG_TTL_SECONDS=300

# Optional direct Groq free-plan routing. Confirm the account has no paid plan.
# Both switches and a backend-only key are required. Long prompts use OpenRouter.
ENABLE_GROQ=false
GROQ_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
MAX_GROQ_REQUESTS_PER_DAY=120
MAX_GROQ_REQUESTS_PER_USER_PER_DAY=30
MAX_GROQ_TOKENS_PER_DAY=180000

# Hosted free-tier protection.
MAX_SEARCHES_PER_USER_PER_DAY=10
MAX_AI_CALLS_PER_USER_PER_DAY=30
MAX_RESUME_PARSES_PER_USER_PER_DAY=5
