# Local-only AI. Start Ollama and pull an installed model before enabling.
ENABLE_LOCAL_LLM=false
# Preparation and drafting work without enabling live submissions.
ENABLE_LIVE_SUBMISSION=false

# Optional Chrome extension: copy its 32-letter ID from chrome://extensions.
# Empty means no extensions are trusted. Comma-separate IDs if needed.
TRUSTED_EXTENSION_IDS=
